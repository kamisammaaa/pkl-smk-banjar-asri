    <h2>DATA PERUSAHAAN PKL SISWA</h2>
    <p class="subtitle">SMK Banjar Asri - Tahun Ajaran {{ date('Y/20Y') }}</p>

    <table>
        <thead>
            <tr>
                <th width="5%">No</th>
                <th width="20%">Nama Siswa</th>
                <th width="25%">Perusahaan</th>
                <th width="25%">Pembimbing|Alamat Pembimbing|TTL</th>
                <th width="15%">No. Telepon</th>
                <th width="10%">Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach($data as $index => $d)
            <tr>
                <td>{{ $index + 1 }}</td>
                <td>{{ $d->siswa->name }}</td>
                <td>
                    <strong>{{ $d->nama_perusahaan }}</strong><br>
                    <small>{{ $d->alamat_perusahaan }}</small>
                </td>
                <td>
                    {{ $d->nama_pembimbing }}<br>
                    <small>{{ $d->ttl_pembimbing }}</small>
                </td>
                <td>{{ $d->no_telp }}</td>
                <td>{{ $d->is_verified ? '✅' : '⏳' }}</td>
            </tr>
            @endforeach
        </tbody>
    </table>

    <div style="margin-top: 30px; text-align: right; font-size: 12px; color: #666;">
        Dicetak pada: {{ now()->format('d F Y H:i') }} WIB
    </div>
